    <div class="modal-content">
      
      <div class="modal-body">
        <h3>Register</h3>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <div class="login-box">
            <div class="row">
                <div class="col-md-6">
                    <div class="field">
                        <input type="text" name="fullname" id="fullname1" placeholder="First Name1">
