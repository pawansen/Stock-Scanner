                    </div>
                </div>
                <div class="col-md-6">
                    <div class="field">
                        <input type="password" name="fullname" id="lo-password4" placeholder="Password">
                        <label for="lo-password4">Password</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="field">
